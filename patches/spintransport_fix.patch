+      //----------------------------------------------------------------------------
+      // Snap a floating-point value onto the nearest integer if it lies within a
+      // small tolerance of it. Cell-boundary coordinates generated from ratios
+      // such as N*cell_size/N are not guaranteed to equal the intended integer
+      // exactly in IEEE-754 arithmetic (e.g. 3.0 may arrive as 2.9999999999999996),
+      // so a naive floor()/static_cast<int>() on the raw quotient silently
+      // misassigns the atom/cell count by one. Values that are genuinely not near
+      // an integer (e.g. 2.7) are returned unchanged so real interior positions
+      // are never snapped to the wrong cell.
+      //----------------------------------------------------------------------------
+      double snap_near_integer(const double value){
+         const double nearest = std::round(value);
+         const double tolerance = 64.0 * std::numeric_limits<double>::epsilon() * std::max(1.0, std::abs(value));
+         if(std::abs(value - nearest) <= tolerance) return nearest;
+         return value;
+      }
+
+      //----------------------------------------------------------------------------
+      // Number of spin-transport cells spanning a system dimension, robust to
+      // floating-point error in system_size/cell_size landing just below an
+      // integer (which would otherwise make ceil() round up to one cell too many).
+      //----------------------------------------------------------------------------
+      int calculate_number_of_cells(const double system_size, const double cell_size){
+         if(cell_size <= 0.0){
+            terminaltextcolor(RED);
+            std::cerr << "Error - spin-transport cell size must be positive" << std::endl;
+            terminaltextcolor(WHITE);
+            zlog << zTs() << "Error - spin-transport cell size must be positive" << std::endl;
+            err::vexit();
+         }
+         const double quotient = snap_near_integer(system_size / cell_size);
+         return static_cast<int>(std::ceil(quotient));
+      }
+
+      //----------------------------------------------------------------------------
+      // Cell index along one axis for an atom at the given coordinate, robust to
+      // floating-point error at exact cell boundaries (which would otherwise
+      // truncate to the cell below). Coordinates that fall genuinely outside the
+      // cell grid (rather than merely rounding error at the outer boundary) are
+      // treated as a fatal input error rather than silently clamped, since a
+      // silent clamp could mask a real out-of-range configuration.
+      //----------------------------------------------------------------------------
+      unsigned int calculate_cell_id(const double coordinate, const double cell_size, const int number_of_cells){
+         const double quotient = snap_near_integer(coordinate / cell_size);
+         const long long cell_id = static_cast<long long>(std::floor(quotient));
+         if(cell_id < 0 || cell_id >= static_cast<long long>(number_of_cells)){
+            terminaltextcolor(RED);
+            std::cerr << "Error - spin-transport atom coordinate " << coordinate
+                       << " lies outside the spin-transport cell grid (cell " << cell_id
+                       << " of " << number_of_cells << ")" << std::endl;
+            terminaltextcolor(WHITE);
+            zlog << zTs() << "Error - spin-transport atom coordinate " << coordinate
+                 << " lies outside the spin-transport cell grid (cell " << cell_id
+                 << " of " << number_of_cells << ")" << std::endl;
+            err::vexit();
+         }
+         return static_cast<unsigned int>(cell_id);
+      }
+
+   } // end of anonymous namespace
